import com.falaai.ApiClient;
import com.falaai.Configuration;
import com.falaai.api.WhatsappApi;
import java.io.File;

public class WhatsappExample {
    public static void main(String[] args) throws Exception {
        Configuration config = new Configuration();
        config.setHost(System.getenv().getOrDefault("FALAAI_BASE_URL", "https://api01-falaai.action.tec.br"));
        config.setAccessToken(System.getenv("FALAAI_API_KEY"));
        WhatsappApi whatsappApi = new WhatsappApi(new ApiClient(config));

        // REQUIRED: file (.zip/.txt export), start, end, timezone, date_format + Authorization
        // OPTIONAL: gap_minutes (default 720) | min_messages (default 2) | chars_per_minute (default 800) | client_reference_id
        var result = whatsappApi.extractConversations(
            new File("demo_whatsapp.zip"),
            "2024-01-01T00:00:00",
            "2024-12-31T23:59:59",
            "-3",
            "day_first",
            720,
            2,
            800
        );

        System.out.println(result);
    }
}
